{
  "name": "crumple-zone-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Host-side chaos panel, telemetry bridge, AI incident report and test runners for Crumple Zone (QNX OS 8.0).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "smoke": "tsx src/tools/smoke.ts",
    "results": "tsx src/tools/results.ts",
    "record": "tsx src/tools/record.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
